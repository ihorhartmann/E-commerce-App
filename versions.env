# The version of each of our services that a platform release deploys (docker-compose.prod.yaml takes each image's tag
# from its line): a tag ghcr.io/<owner>/<repository>/<service>:<version> the Service Release workflow built.
#
# Changed by the Service Release workflow only - a tag <service>/vX.Y.Z builds that service's image and opens (or adds
# to) the pull request release/versions with its new line - never by hand. A platform tag vX.Y.Z then deploys the
# versions of its commit, together with the compose files and configuration of that commit (infrastructure/contabo).
INVENTORY_SERVICE_IMAGE_TAG=v0.2.0
ORDER_SERVICE_IMAGE_TAG=v0.1.1
PAYMENT_SERVICE_IMAGE_TAG=v0.1.0
SHIPPING_SERVICE_IMAGE_TAG=v0.1.0
GATEWAY_SERVICE_IMAGE_TAG=v0.1.0
WEB_UI_IMAGE_TAG=v0.2.1
