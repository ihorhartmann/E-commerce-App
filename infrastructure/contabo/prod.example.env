# --- production (infrastructure/contabo): appended to example.env by scripts/generate-env.sh

# every `docker compose` command in the repository's folder merges both files
COMPOSE_FILE=docker-compose.yaml:docker-compose.prod.yaml

# the images of our services: ghcr.io/<owner>/<repository> and a tag the Build Images workflow pushed
IMAGE_PREFIX=ghcr.io/ihorhartmann/e-commerce-app
IMAGE_TAG=

# the shop is on the domain itself, Keycloak on auth.<domain>; both need an A record pointing at the server
DOMAIN=example.com
KEYCLOAK_URL=https://auth.${DOMAIN}
GATEWAY_PUBLIC_URL=https://${DOMAIN}
WEB_UI_PUBLIC_URL=https://${DOMAIN}
# empty: Let's Encrypt's staging CA (untrusted certificates, no rate limits worth speaking of). Once the staging
# certificates are issued, switch to the real one: https://acme-v02.api.letsencrypt.org/directory
ACME_CA=

