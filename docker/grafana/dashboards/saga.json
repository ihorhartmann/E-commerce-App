      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (message_type) ((((increase(ecommerce_outbox_messages_published_total[$__rate_interval]) + (min_over_time(ecommerce_outbox_messages_published_total[$__rate_interval]) unless present_over_time(ecommerce_outbox_messages_published_total[$__rate_interval] offset $__rate_interval))) or increase(ecommerce_outbox_messages_published_total[$__rate_interval]) or (min_over_time(ecommerce_outbox_messages_published_total[$__rate_interval]) unless present_over_time(ecommerce_outbox_messages_published_total[$__rate_interval] offset $__rate_interval))) / ($__rate_interval_ms / 1000)))",
          "instant": false,
          "legendFormat": "{{message_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Saga events per second",
      "type": "timeseries"
    },
