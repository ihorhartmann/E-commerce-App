    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "The orders Stuck orders counts, oldest first. Click one for its journey: its traces and logs show the step the saga stopped at. Right now - the time range doesn't change it.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Order"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Journey of order ${__value.raw}",
                    "url": "/d/ecommerce-order-journey?${__url_time_range}\u0026var-order=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 10
      },
      "id": 6,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS \"Order\", status AS \"Status\", COALESCE(updated_at, created_at) AS \"Unchanged since\"\nFROM grafana.orders\nWHERE status IN ('PLACED', 'CANCEL_REQUESTED') AND COALESCE(updated_at, created_at) \u003c now() - INTERVAL '30 minutes'\nORDER BY 3",
          "refId": "A"
        }
      ],
      "title": "Stuck orders - which",
      "type": "table"
    },
