    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Orders placed, and orders fulfilled, in the selected time range - it changes with the range.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by () (ecommerce_orders_count{}) - (sum by () (ecommerce_orders_count{} offset $__range) or (min_over_time((sum by () (ecommerce_orders_count{}))[$__range:1m]) and on () absent(ecommerce_outbox_pending offset $__range)) or sum by () (ecommerce_orders_count{}) * 0), 0)",
          "instant": true,
          "legendFormat": "placed",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by () (ecommerce_orders_count{status=\"FULFILLED\"}) - (sum by () (ecommerce_orders_count{status=\"FULFILLED\"} offset $__range) or (min_over_time((sum by () (ecommerce_orders_count{status=\"FULFILLED\"}))[$__range:1m]) and on () absent(ecommerce_outbox_pending offset $__range)) or sum by () (ecommerce_orders_count{status=\"FULFILLED\"}) * 0), 0)",
          "instant": true,
          "legendFormat": "fulfilled",
          "range": false,
          "refId": "B"
        }
