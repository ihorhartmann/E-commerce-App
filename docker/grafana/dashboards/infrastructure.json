      "panels": [],
      "title": "Containers",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every container of the compose project seen in the last day: running, or down - red - when cAdvisor hasn't seen it for over a minute. kafka-init is left out: it runs once at startup and exits.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "down"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (container_label_com_docker_compose_service) (container_last_seen{container_label_com_docker_compose_service!=\"\", container_label_com_docker_compose_service!=\"kafka-init\"} \u003e time() - 60) or max by (container_label_com_docker_compose_service) (max_over_time(container_last_seen{container_label_com_docker_compose_service!=\"\", container_label_com_docker_compose_service!=\"kafka-init\"}[1d])) * 0",
          "instant": true,
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Containers running",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How often each container started in the selected time range - a crash loop shows up here. kafka-init is left out: it runs once at startup.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container_label_com_docker_compose_service) (changes(container_start_time_seconds{container_label_com_docker_compose_service!=\"\", container_label_com_docker_compose_service!=\"kafka-init\"}[$__range])) or max by (container_label_com_docker_compose_service) (max_over_time(container_last_seen{container_label_com_docker_compose_service!=\"\", container_label_com_docker_compose_service!=\"kafka-init\"}[1d])) * 0",
          "instant": true,
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Container restarts in range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU cores each compose service uses.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
