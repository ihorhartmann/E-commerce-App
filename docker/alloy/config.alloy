// The single place the services send their telemetry to (OTLP), and the one that collects their logs and the
// infrastructure's metrics. Which backend it all ends up in is decided here only, so moving from this compose stack to
// Kubernetes or a managed backend changes this file, not the services.

// ---- Traces and metrics ----

// The services push both over OTLP/HTTP: spans go on to Tempo, metrics to Prometheus.
otelcol.receiver.otlp "services" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.memory_limiter.default.input]
    metrics = [otelcol.processor.memory_limiter.default.input]
  }
}

// Refuses data instead of growing until the container is OOM-killed: above 60% of the container's memory limit
// (80% minus 20% headroom for spikes) new data is rejected and the senders retry later; at 80% it forces a GC. The
// limit is read from the container (mem_limit in docker-compose.yaml), so changing it there is enough.
otelcol.processor.memory_limiter "default" {
  check_interval         = "1s"
  limit_percentage       = 80
  spike_limit_percentage = 20

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

// Prometheus takes OTLP itself (--web.enable-otlp-receiver): the exporter adds /v1/metrics to this endpoint.
otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

// ---- Metrics of the infrastructure ----

// What the services can't measure themselves, from exporters built into Alloy - no container of their own - scraped
// every 15s - the services' export interval - and pushed to Prometheus with remote write
// (--web.enable-remote-write-receiver).

// Postgres itself - connections against max_connections, deadlocks, database size - and the custom queries over the
// services' tables: outbox backlog, orders by status, stuck orders, saga durations, payments, refunds, shipments.
prometheus.exporter.postgres "postgres" {
  data_source_names          = [string.format("postgresql://%s:%s@postgres:5432/%s?sslmode=disable", sys.env("POSTGRES_USER"), sys.env("POSTGRES_PASSWORD"), sys.env("POSTGRES_DB"))]
  custom_queries_config_path = "/etc/alloy/postgres-queries.yaml"
}

// Consumer lag by consumer group, topic and partition - the Go and the Spring consumers alike - plus brokers and
// under-replicated partitions.
prometheus.exporter.kafka "kafka" {
  kafka_uris = ["kafka:9092"]
}

// CPU, memory against the limit, restarts and network of every container. Needs the host's /, /sys, /var/lib/docker
// and containerd's socket mounted read-only (docker-compose.yaml) - not a privileged Alloy.
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
  // the compose service as a label, not every label of the container
  store_container_labels       = false
  allowlisted_container_labels = ["com.docker.compose.service"]
}

// Free space of the Docker host's file systems - where the volumes of Postgres, Tempo, Loki and Prometheus live.
prometheus.exporter.unix "host" {
  set_collectors = ["filesystem"]
  rootfs_path    = "/rootfs"
}

// Alloy's own health: spans, metrics and log lines it dropped or failed to export.
prometheus.exporter.self "alloy" { }

prometheus.scrape "infrastructure" {
  targets = array.concat(
    prometheus.exporter.postgres.postgres.targets,
    prometheus.exporter.kafka.kafka.targets,
    prometheus.exporter.cadvisor.containers.targets,
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.self.alloy.targets,
    // Keycloak's own metrics on its management port, failed logins among them (KC_EVENT_METRICS_USER_ENABLED)
    [{"__address__" = "keycloak:9000", "job" = "keycloak"}],
  )
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ---- Logs ----

// The services only write to stdout; the lines are read from Docker, from the containers of this compose project.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=e-commerce-app"]
  }
}

// Every stream is labelled with its compose service - order-service, kafka, ... - the same name the service's spans
// carry as service.name, so a span leads to its logs.
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.services.receiver]
}

// The services write a JSON object per line: its level becomes a label - only a handful of values, so it stays cheap
// to index - and its trace id structured metadata, kept next to the line without a stream of its own. The other
// containers (Kafka, Postgres, Keycloak, ...) log plain text, passed on as it is.
loki.process "services" {
  stage.match {
    selector = "{service=~\".+-service\"}"

    stage.json {
      expressions = {
        level   = "level",
        traceId = "traceId",
      }
    }

    stage.labels {
      values = {
        level = "",
      }
    }

    stage.structured_metadata {
      values = {
        traceId = "",
      }
    }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
