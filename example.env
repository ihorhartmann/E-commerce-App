INVENTORY_SERVICE_PORT=3001

ORDER_SERVICE_PORT=3002

PAYMENT_SERVICE_PORT=3003
STRIPE_SECRET_KEY=key
STRIPE_PUBLISHABLE_KEY=key
STRIPE_WEBHOOK_SECRET=key

SHIPPING_SERVICE_PORT=3004

KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=9098

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

KEYCLOAK_PORT=8090
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=password

GATEWAY_PORT=8080
GATEWAY_CLIENT_SECRET=gateway-local-dev-secret

WEB_UI_PORT=3000
ORDER_SERVICE_CLIENT_SECRET=order-service-local-dev-secret

GRAFANA_PORT=8089
# the password of grafana_reader, the read-only Postgres user of Grafana's datasource
GRAFANA_DB_PASSWORD=grafana-reader-local-dev-password
ALLOY_UI_PORT=12345

# the alert emails (docker/alertmanager): the Gmail account that sends them, with an App Password
# (https://myaccount.google.com/apppasswords - needs 2-Step Verification), and the recipient
ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
ALERT_SMTP_USERNAME=alerts-sender@gmail.com
ALERT_SMTP_PASSWORD=gmail-app-password
ALERT_EMAIL_FROM=alerts-sender@gmail.com
ALERT_EMAIL_TO=you@example.com

# the password of the admin in docker/keycloak/realm-ecommerce.json (the clients and couriers are the public demo
# accounts, password `demo`); the realm's password policy: 8 characters at least, neither the username nor the email
APP_ADMIN_PASSWORD=admin-password
# the clients for the e2e tests and Postman in the realm; false in production
KC_TEST_CLIENTS_ENABLED=true

# the lowest level every service logs - DEBUG, INFO, WARN, ERROR; INFO when not set
LOG_LEVEL=INFO
