# Rendered by the nginx image's envsubst step from the env vars WEB_UI_PORT and STRIPE_PUBLISHABLE_KEY.
# nginx serves the app's static files and /config.json only. Caddy stands in front of it (docker/caddy/shop.caddy)
# and sends the gateway's paths - /api, /oauth2, /login, /logout - to the gateway itself, on the same origin.

server {
    listen ${WEB_UI_PORT};
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        try_files $uri /index.html;
    }

    # the bundle keeps the same file names across builds: always revalidate, so a new build shows up at once
    location ~* \.(html|js|css)$ {
        add_header Cache-Control "no-cache";
    }

    # product photos never change under the same name (a new photo gets a new file), so a browser keeps them a week
    # without asking again; a missing one is a 404, not the app's page
    location /images/products/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800";
    }

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"stripePublishableKey":"${STRIPE_PUBLISHABLE_KEY}"}';
    }
}
